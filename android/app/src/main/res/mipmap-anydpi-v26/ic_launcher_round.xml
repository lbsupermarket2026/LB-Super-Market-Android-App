<?xml version="1.0" encoding="utf-8"?>
<!-- FIXED: previously wrapped the foreground in <inset
     android:inset="16%">, shrinking it further on top of the padding
     already baked into the source image itself — the two stacked
     is what made the icon look unnecessarily small. Removed the
     inset entirely, since the new foreground image (see
     drawable-*/ic_launcher_foreground.png) already has an
     appropriate safe-zone margin built in directly. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
