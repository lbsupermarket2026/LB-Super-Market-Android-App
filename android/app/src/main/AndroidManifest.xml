<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required on Android 13+ (API 33+) for the system notification
         permission prompt to appear at all — without this, requesting
         permission at runtime silently does nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="LB Super Market"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- NEW: without this, FCM's native handling of notifications
             while the app is backgrounded/terminated falls back to its
             own default icon behavior — which is the same "reuse the
             full-color launcher icon" problem described in
             push_notification_service.dart, just for the native/FCM
             path instead of the flutter_local_notifications path.
             Points at the same white silhouette used there, so the
             status bar icon looks correct in EVERY app state
             (foreground, background, and terminated). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ (API 30+) for image_picker's camera
             capture to resolve an installed camera app at all — same
             package-visibility restriction as the url_launcher entries
             below, just for ACTION_IMAGE_CAPTURE instead. Without this,
             invoking the camera can fail at the native/OS level in a way
             Dart's own exception handling never sees, which is why this
             showed up as a full crash rather than a catchable error. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- Required on Android 11+ (API 30+) for url_launcher to resolve
             an installed app for these schemes at all — without this,
             canLaunchUrl/launchUrl silently fail even when e.g. Chrome
             or WhatsApp is installed, because package visibility hides
             them by default unless explicitly declared here. Covers
             WhatsApp links (https), Call Delivery/Call Us (tel), and
             Support email links (mailto) throughout the app. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- Without this, Android 11+ hides every UPI app (PhonePe,
             GPay, Paytm, CRED, etc.) from Razorpay's checkout entirely
             — they silently just don't show up as tappable options,
             same class of restriction as the entries above, just for
             the upi:// scheme specifically. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
    </queries>
</manifest>